(defpoll wifi_list :interval "20s"
  "~/.config/eww/scripts/wifi_scan.sh")

(defwindow wifi_popup
  :monitor "eDP-1"
  :geometry (geometry :x "8%" 
                       :y "0%" 
                       :width "300px" 
                       :height "400px" 
                       :anchor "top right")
  :stacking "fg"
  (box :class "island popup" :orientation "v" :space-evenly false :spacing 15
    (label :text "Available Networks" :class "popup-title" :halign "start")
    (scroll :vscroll true :height 320
      (literal :content "(box :orientation 'v' :spacing 8 ${wifi_list})"))
    (button :class "popup-close" :onclick "eww close wifi_popup" "Close")))
