# Fallback only. theme-sync writes Ptyxis's palette itself (wal.palette, the
# same colours as Alacritty); waypaper/wallpaper_update.sh copies this pywal
# rendering into ~/.local/share/org.gnome.Ptyxis/palettes/wal.palette only on
# a machine without theme-sync.
#
# Format is a GKeyFile, matching Ptyxis's own bundled palettes: one [Palette]
# section, Color0-15, and no Light/Dark split.
[Palette]
Name=Wal
Background={background}
Foreground={foreground}
Cursor={cursor}
Color0={color0}
Color1={color1}
Color2={color2}
Color3={color3}
Color4={color4}
Color5={color5}
Color6={color6}
Color7={color7}
Color8={color8}
Color9={color9}
Color10={color10}
Color11={color11}
Color12={color12}
Color13={color13}
Color14={color14}
Color15={color15}
