/*
 * rofi theme — layout only; every colour comes from pywal.
 *
 * colors-rofi-dark.rasi  : pywal's own export (@background, @foreground, ...)
 * colors-rofi-alpha.rasi : this repo's pywal template (wal/.config/wal/templates),
 *                          which bakes the translucent surfaces — rofi 1.7.5
 *                          cannot compute alpha from a variable.
 *
 * Both are regenerated by `wal` on every wallpaper change, so rofi follows the
 * wallpaper the same way the eww bar does. Never hardcode a hex here.
 */

@import "~/.cache/wal/colors-rofi-dark.rasi"
@import "~/.cache/wal/colors-rofi-alpha.rasi"

* {
    width: 600;
    font:  "JetBrainsMono Nerd Font 18";

    background-color: transparent;
    text-color:       @foreground;

    /*
     * pywal's export styles rows through #element.<state>.<state>, which is
     * more specific than anything written here — so the row colours have to be
     * changed at the variables those rules read, not with an `element selected`
     * rule.
     */
    normal-background:           transparent;
    active-background:           transparent;
    urgent-background:           transparent;
    alternate-normal-background: transparent;
    alternate-active-background: transparent;
    alternate-urgent-background: transparent;

    selected-normal-background:  @wal-accent;
    selected-normal-foreground:  @background;
    selected-active-background:  @wal-accent;
    selected-active-foreground:  @background;
    selected-urgent-background:  @wal-accent;
    selected-urgent-foreground:  @background;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height:           360px;
    border:           0;
    border-radius:    14px;
    background-color: @wal-surface;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: transparent;
    padding:          2px;
}

prompt {
    background-color: @wal-accent;
    text-color:       @background;
    padding:          6px;
    border-radius:    8px;
    margin:           20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str:    ":";
}

entry {
    padding:          6px;
    margin:           20px 0px 0px 10px;
    text-color:       @foreground;
    background-color: transparent;
}

listview {
    border:           0px;
    padding:          6px 0px 0px;
    margin:           10px 0px 0px 20px;
    columns:          2;
    lines:            5;
    background-color: transparent;
    scrollbar:        false;
}

element {
    padding:          5px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @foreground;
}

element-icon {
    size: 25px;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @wal-accent;
    text-color:       @background;
}

mode-switcher {
    spacing: 0;
}

button {
    padding:          10px;
    background-color: transparent;
    text-color:       @wal-dim;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: transparent;
    text-color:       @wal-accent;
}

message {
    background-color: @wal-elevated;
    margin:           2px;
    padding:          2px;
    border-radius:    8px;
}

textbox {
    padding:          6px;
    margin:           20px 0px 0px 20px;
    text-color:       @wal-accent;
    background-color: transparent;
}
