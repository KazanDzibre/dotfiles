configuration {
    modi: "drun,run,window,combi";
    icon-theme: "Yaru";
    show-icons: true;
    terminal: "foot";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-combi: " 🖥️  All ";
    display-run: " 🏃  Run ";
    display-window: " 🪟  Window";
    sidebar-mode: true;
}

/* Layout lives here; colours come from pywal via this theme's @import. */
@theme "~/.config/rofi/pywal.rasi"
