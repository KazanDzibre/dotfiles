.claude
CLAUDE.*
.qmlls.ini
__pycache__/
*.pyc

# Generated state that apps write back through the stow symlinks. Config lives
# in the repo; state does not, or every session dirties the tree.
fish/.config/fish/fish_variables

# API keys, read by hyprland.conf (never commit these)
hypr/.config/hypr/secrets*.conf

# waypaper rewrites its wallpaper line on every pick; config.ini.default is the
# tracked starting point (copy it to config.ini on a new machine).
waypaper/.config/waypaper/config.ini
